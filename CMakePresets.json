{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/builds/${presetName}",
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": {
                    "type": "BOOL",
                    "value": true
                }
            }
        },
        {
            "name": "vs-base",
            "hidden": true,
            "inherits": [
                "base"
            ],
            "generator": "Visual Studio 17 2022",
            "architecture": "x64"
        },
        {
            "name": "headless",
            "hidden": true,
            "cacheVariables": {
                "CLAP_PLUGINS_HEADLESS": {
                    "type": "BOOL",
                    "value": true
                }
            }
        },
        {
            "name": "ninja",
            "description": "Ninja",
            "inherits": [
                "base"
            ]
        },
        {
            "name": "ninja-headless",
            "description": "Ninja, without the GUI",
            "inherits": [
                "base",
                "headless"
            ]
        },
        {
            "name": "vs",
            "description": "Visual Studio 2022",
            "inherits": [
                "vs-base"
            ]
        },
        {
            "name": "vs-headless",
            "description": "Visual Studio 2022, without the GUI",
            "inherits": [
                "vs-base",
                "headless"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "ninja",
            "description": "Build using Ninja",
            "configurePreset": "ninja"
        },
        {
            "name": "ninja-headless",
            "description": "Build using Ninja, without the GUI",
            "configurePreset": "ninja-headless"
        },
        {
            "name": "vs",
            "description": "Build using Visual Studio",
            "configurePreset": "vs"
        },
        {
            "name": "vs-headless",
            "description": "Build using Visual Studio, without the GUI",
            "configurePreset": "vs-headless"
        }
    ],
    "testPresets": [
        {
            "name": "ninja",
            "description": "Test using Ninja",
            "configurePreset": "ninja"
        },
        {
            "name": "ninja-headless",
            "description": "Test using Ninja, without the GUI",
            "configurePreset": "ninja-headless"
        },
        {
            "name": "vs",
            "description": "Test using Visual Studio",
            "configurePreset": "vs"
        },
        {
            "name": "vs-headless",
            "description": "Test using Visual Studio, without the GUI",
            "configurePreset": "vs-headless"
        }
    ]
}
